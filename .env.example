# ==============================================================================
# Poodll LMS Automation - Environment Configuration Template
# Duplicate this file as '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file containing real secrets or passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LMS / Moodle Authentication
# ------------------------------------------------------------------------------
# Your institution's primary LMS username / ID
LMS_USERNAME=your_username_here

# Your institution's primary LMS password
LMS_PASSWORD=your_password_here

# Target Course or Activity URL (Direct URL to automate)
TARGET_URL=https://moodle.your-institution.edu/course/view.php?id=101

# Optional: Comma-separated or JSON array of multiple course URLs
# COURSE_URLS=https://moodle.your-institution.edu/course/view.php?id=101,https://moodle.your-institution.edu/course/view.php?id=102

# ------------------------------------------------------------------------------
# 2. Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (default: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. Activity Passing Score Thresholds (0 - 100 percentage)
# ------------------------------------------------------------------------------
PASSING_THRESHOLD=70
READALOUD_MIN_SCORE=80
SOLO_MIN_SCORE=70
HVP_MIN_SCORE=70
WORDCARDS_MIN_SCORE=70
QUIZ_MIN_SCORE=70

# ------------------------------------------------------------------------------
# 4. Audio Pipeline & Virtual Cable Routing
# ------------------------------------------------------------------------------
CABLE_INPUT_NAME=CABLE Input
CABLE_OUTPUT_NAME=CABLE Output
TTS_RATE=170
TTS_VOLUME=1.0

# ------------------------------------------------------------------------------
# 5. Browser Execution Options
# ------------------------------------------------------------------------------
HEADLESS=false
BROWSER_CHANNEL=chrome
